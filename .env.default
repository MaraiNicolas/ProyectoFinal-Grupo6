# Configuracion por defecto - TODO funciona con mocks (sin dependencias externas).
# Copiar este archivo a ".env" para levantar el sistema inmediatamente.
#
# Comando: cp .env.default .env && docker compose up --build -d
#
# Luego configurar cada servicio real editando el .env segun se necesite.

# --- Base de datos ---
DB_CONNECTION_STRING=Data Source=/app/data/grupo6.db

# --- SSO Finnegans (mock - login con botones de prueba) ---
FINNEGANS_ENABLED=true
FINNEGANS_USE_MOCK=true
BASE_GO_URL=http://localhost
FINNEGANS_INVITADOS_ENDPOINT=/api/1/invitados
FINNEGANS_AUTO_CREATE=true
FINNEGANS_ROL_DEFAULT=Admin
FINNEGANS_CACHE_TTL_MINUTES=5

# --- HikCentral (mock - reservas simuladas) ---
HIKCENTRAL_USE_MOCK=true
HIKCENTRAL_BASE_URL=
HIKCENTRAL_PARTNER_KEY=
HIKCENTRAL_PARTNER_SECRET=

# --- Auditoria (mock - logs en memoria) ---
AUDIT_USE_MOCK=true
DYNAMODB_PORT=8000

# --- Email (mock - emails en consola, no se envian) ---
EMAIL_USE_MOCK=true
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Sistema de Visitas

# --- Frontend ---
APP_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080/api
VITE_SHOW_MOCK_SSO=true
